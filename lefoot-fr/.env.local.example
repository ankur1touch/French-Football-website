# Public — set NEXT_PUBLIC_SITE_URL to your Amplify domain after first deploy
NEXT_PUBLIC_SITE_URL=https://your-branch.amplifyapp.com
NEXT_PUBLIC_RSS_GOAL_FR=https://www.goal.com/feeds/fr/news
NEXT_PUBLIC_RSS_GOOGLE_FR=https://news.google.com/rss/search?q=football&hl=fr&gl=FR&ceid=FR:fr

# OnzeActu CMS API (onzeactu.com articles)
NEXT_PUBLIC_CMS_API_URL=https://api.onzeactu.com/api
# Local dev override: NEXT_PUBLIC_CMS_API_URL=http://localhost:4000/api

# Server-only football proxy (do not prefix with NEXT_PUBLIC_)
FOOTBALL_PROXY_BASE_URL=https://api.labenditaec.com/api/football
FOOTBALL_SEASON=2026
FOOTBALL_WORLD_CUP_ID=1
FOOTBALL_PRIMARY_LEAGUE_ID=1
FOOTBALL_PRIMARY_LEAGUE_NAME=Coupe du Monde FIFA 2026
FOOTBALL_LIGUE1_ID=61
FOOTBALL_CHAMPIONS_LEAGUE_ID=2
FOOTBALL_LIGUE2_ID=62
FOOTBALL_ENABLE_MOCK_FALLBACK=true
FOOTBALL_TIMEOUT_MS=8000

# CMS publishing (n8n → POST /api/articles)
CMS_API_TOKEN=your-secret-token
MONGODB_URI=
MONGODB_DB=lefoot_fr
